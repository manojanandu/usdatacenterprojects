{
  "name": "usdatacenterprojects",
  "main": "_worker.js",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "usdatacenterprojects.com/*", "zone_name": "usdatacenterprojects.com" },
    { "pattern": "www.usdatacenterprojects.com/*", "zone_name": "usdatacenterprojects.com" }
  ]
}
